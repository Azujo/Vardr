# Klucze i certyfikaty – nigdy do repozytorium
certs/
*.key
*.pem

# Dane i stan lokalny
data/

# Binaria
bin/
*.exe

# Sekrety stosu laboratoryjnego
.env

# Paczki instalacyjne agentów (zawierają klucze prywatne)
/dist/

# Frontend panelu: zależności i wynik budowania (poza znacznikiem katalogu)
panel/web/node_modules/
panel/web/dist/*
!panel/web/dist/.gitkeep

# Archiwum NIS2 (Urd) na VM laboratoryjnej
deploy/lab/archive/

# Metryki skryptów laboratorium (node-exporter, textfile)
deploy/lab/metrics/

# Programy dołączane do eksportów archiwum (budowane przez deploy.sh tools)
deploy/lab/export-tools/

# Reguły SigmaHQ – import opcjonalny, decyzja administratora (docs/reguly.md, „Import reguł SigmaHQ”);
# licencja DRL 1.1, nie dystrybuujemy ich z repozytorium.
rules/sigmahq/
check.txt
