# Pliki uruchamiane lub montowane na serwerze Linux muszą mieć końce linii LF,
# niezależnie od ustawienia core.autocrlf na stacji Windows.
deploy/** text eol=lf
*.sh      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.conf    text eol=lf
# Skrypty i SQL osadzane w programach (go:embed) – np. skrypt sprawdzający
# dołączany do eksportu archiwum musi działać u odbiorcy na Linuksie.
*.py      text eol=lf
*.sql     text eol=lf

# Binaria i klucze nigdy nie są przetwarzane jako tekst.
*.exe binary
*.key binary
*.crt binary
# Korpus fuzzingu Go – format wrażliwy na końce linii.
**/testdata/** text eol=lf
*.ps1     text eol=crlf
