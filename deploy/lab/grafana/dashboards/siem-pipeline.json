{
  "uid": "siem-pipeline",
  "title": "SIEM – zdrowie potoku",
  "description": "Przepływ zdarzeń przez ingest, kolejkę, normalizator i writer; odmowy przy przeciążeniu; opóźnienia i zasoby (etap 1.5, K4).",
  "tags": ["siem", "potok"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    { "id": 1, "type": "stat", "title": "Przyjęte (zdarzenia/s)",
      "description": "Zdarzenia przyjęte przez ingest do kolejki (bez duplikatów).",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus-siem" },
      "targets": [{ "refId": "A", "expr": "sum(rate(siem_ingest_events_total[1m]))" }],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "area" } },
    { "id": 2, "type": "stat", "title": "Zapisane w bazie (zdarzenia/s)",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus-siem" },
      "targets": [{ "refId": "A", "expr": "sum(rate(siem_writer_rows_total[1m]))" }],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "area" } },
    { "id": 3, "type": "stat", "title": "Odmowy (paczki/s)",
      "description": "Paczki odesłane agentom do ponowienia (429 – serwer zajęty, 503 – kolejka pełna lub niedostępna). Dane czekają u agentów.",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus-siem" },
      "targets": [{ "refId": "A", "expr": "sum(rate(siem_ingest_batches_total{result=~\"throttled_.*|queue_error\"}[1m])) or vector(0)" }],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 1,
        "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 0.1 }, { "color": "red", "value": 5 } ] } } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" } },
    { "id": 4, "type": "stat", "title": "Opóźnienie potoku p99",
      "description": "Od przyjęcia paczki przez ingest do zapisu zdarzenia w ClickHouse.",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus-siem" },
      "targets": [{ "refId": "A", "expr": "histogram_quantile(0.99, sum by (le) (rate(siem_writer_pipeline_latency_seconds_bucket[1m])))" }],
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 1,
        "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 10 }, { "color": "red", "value": 60 } ] } } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" } },
    { "id": 5, "type": "stat", "title": "Zajętość kolejek (maks.)",
      "description": "Powyżej 50% etap nie nadąża – dołóż kopie. Od 90% ingest odmawia przyjęcia.",
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus-siem" },
      "targets": [{ "refId": "A", "expr": "max(siem_queue_fill_ratio)" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "decimals": 1, "min": 0, "max": 1,
        "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 0.5 }, { "color": "red", "value": 0.8 } ] } } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" } },
    { "id": 6, "type": "stat", "title": "Kopie usług",
      "gridPos": { "x": 20, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus-siem" },
      "targets": [{ "refId": "A", "expr": "sum by (service) (up{job=\"siem\"})", "legendFormat": "{{service}}" }],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "value_and_name", "graphMode": "none" } },

    { "id": 10, "type": "timeseries", "title": "Przepływ zdarzeń przez etapy (zdarzenia/s)",
      "description": "Linie powinny się pokrywać. Rozjazd oznacza, że któryś etap nie nadąża (rośnie kolejka).",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus-siem" },
      "targets": [
        { "refId": "A", "expr": "sum(rate(siem_ingest_events_total[1m]))", "legendFormat": "ingest – przyjęte" },
        { "refId": "B", "expr": "sum(rate(siem_normalizer_events_total[1m]))", "legendFormat": "normalizator" },
        { "refId": "C", "expr": "sum(rate(siem_writer_rows_total[1m]))", "legendFormat": "writer – zapisane" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 5 } } } },
    { "id": 11, "type": "timeseries", "title": "Paczki w ingest według wyniku (paczki/s)",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus-siem" },
      "targets": [{ "refId": "A", "expr": "sum by (result) (rate(siem_ingest_batches_total[1m]))", "legendFormat": "{{result}}" }],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 10, "stacking": { "mode": "normal" } } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "accepted" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } } ] },
          { "matcher": { "id": "byName", "options": "throttled_busy" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } } ] },
          { "matcher": { "id": "byName", "options": "throttled_queue_full" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] },
          { "matcher": { "id": "byName", "options": "queue_error" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "dark-red" } } ] },
          { "matcher": { "id": "byName", "options": "rejected" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "purple" } } ] }
        ] } },

    { "id": 20, "type": "timeseries", "title": "Zajętość kolejek NATS",
      "gridPos": { "x": 0, "y": 12, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus-siem" },
      "targets": [{ "refId": "A", "expr": "max by (stream) (siem_queue_fill_ratio)", "legendFormat": "{{stream}}" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1,
        "custom": { "thresholdsStyle": { "mode": "dashed" } },
        "thresholds": { "mode": "absolute", "steps": [ { "color": "transparent", "value": null }, { "color": "orange", "value": 0.5 }, { "color": "red", "value": 0.9 } ] } } } },
    { "id": 21, "type": "timeseries", "title": "Zaległe wiadomości w kolejkach",
      "description": "Paczki czekające na normalizator (SIEM_RAW) i writer (SIEM_EVENTS).",
      "gridPos": { "x": 8, "y": 12, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus-siem" },
      "targets": [{ "refId": "A", "expr": "max by (stream) (siem_queue_pending_messages)", "legendFormat": "{{stream}}" }],
      "fieldConfig": { "defaults": { "unit": "short" } } },
    { "id": 22, "type": "timeseries", "title": "Paczki w obsłudze (ingest)",
      "description": "Limit na kopię: SIEM_INGEST_MAX_INFLIGHT (domyślnie 64). Po jego osiągnięciu ingest odpowiada 429.",
      "gridPos": { "x": 16, "y": 12, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus-siem" },
      "targets": [{ "refId": "A", "expr": "siem_ingest_in_flight", "legendFormat": "{{instance}}" }],
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 } } },

    { "id": 30, "type": "timeseries", "title": "Opóźnienie potoku (ingest → baza)",
      "gridPos": { "x": 0, "y": 20, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus-siem" },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.5, sum by (le) (rate(siem_writer_pipeline_latency_seconds_bucket[1m])))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.99, sum by (le) (rate(siem_writer_pipeline_latency_seconds_bucket[1m])))", "legendFormat": "p99" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } } },
    { "id": 31, "type": "timeseries", "title": "Czas pracy etapów p99",
      "description": "Obsługa paczki w ingest (z zapisem do NATS), normalizacja paczki, INSERT do ClickHouse.",
      "gridPos": { "x": 8, "y": 20, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus-siem" },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.99, sum by (le) (rate(siem_ingest_request_seconds_bucket{result=\"accepted\"}[1m])))", "legendFormat": "ingest – paczka" },
        { "refId": "B", "expr": "histogram_quantile(0.99, sum by (le) (rate(siem_normalizer_batch_seconds_bucket[1m])))", "legendFormat": "normalizator – paczka" },
        { "refId": "C", "expr": "histogram_quantile(0.99, sum by (le) (rate(siem_writer_insert_seconds_bucket[1m])))", "legendFormat": "writer – INSERT" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } } },
    { "id": 32, "type": "timeseries", "title": "Błędy i kwarantanna (na s)",
      "gridPos": { "x": 16, "y": 20, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus-siem" },
      "targets": [
        { "refId": "A", "expr": "sum(rate(siem_normalizer_quarantined_total[1m]))", "legendFormat": "kwarantanna – normalizacja" },
        { "refId": "B", "expr": "sum(rate(siem_writer_rejected_total[1m]))", "legendFormat": "odrzucone przez bazę" },
        { "refId": "C", "expr": "sum(rate(siem_writer_insert_errors_total[1m]))", "legendFormat": "nieudane INSERT (ponawiane)" },
        { "refId": "D", "expr": "sum by (result) (rate(siem_normalizer_batches_total{result!=\"ok\"}[1m]))", "legendFormat": "normalizator – {{result}}" },
        { "refId": "E", "expr": "sum(rate(siem_ingest_batches_total{result=\"rejected\"}[1m]))", "legendFormat": "ingest – paczki odrzucone" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 } } },

    { "id": 40, "type": "timeseries", "title": "CPU usług (rdzenie)",
      "gridPos": { "x": 0, "y": 28, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus-siem" },
      "targets": [
        { "refId": "A", "expr": "sum by (service, instance) (rate(process_cpu_seconds_total{job=\"siem\"}[1m]))", "legendFormat": "{{service}} {{instance}}" },
        { "refId": "B", "expr": "sum(rate(ClickHouseProfileEvents_OSCPUVirtualTimeMicroseconds[1m])) / 1e6", "legendFormat": "clickhouse (zapytania)" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 2, "min": 0 } } },
    { "id": 41, "type": "timeseries", "title": "Pamięć usług",
      "gridPos": { "x": 8, "y": 28, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus-siem" },
      "targets": [
        { "refId": "A", "expr": "process_resident_memory_bytes{job=\"siem\"}", "legendFormat": "{{service}} {{instance}}" },
        { "refId": "B", "expr": "ClickHouseMetrics_MemoryTracking", "legendFormat": "clickhouse" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes", "min": 0 } } },
    { "id": 42, "type": "timeseries", "title": "ClickHouse – wstawiane wiersze i części",
      "description": "Liczba aktywnych części w partycji rośnie przy zbyt wielu małych INSERT-ach; powyżej ok. 300 ClickHouse zaczyna spowalniać zapis.",
      "gridPos": { "x": 16, "y": 28, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus-siem" },
      "targets": [
        { "refId": "A", "expr": "rate(ClickHouseProfileEvents_InsertedRows[1m])", "legendFormat": "wiersze/s" },
        { "refId": "B", "expr": "ClickHouseAsyncMetrics_MaxPartCountForPartition", "legendFormat": "maks. części w partycji" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 },
        "overrides": [ { "matcher": { "id": "byName", "options": "maks. części w partycji" }, "properties": [ { "id": "custom.axisPlacement", "value": "right" } ] } ] } }
  ]
}
