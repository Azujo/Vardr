# Skopiuj do .env i ustaw hasła (np.: openssl rand -base64 24).
# Plik .env nie trafia do repozytorium.
CLICKHOUSE_ADMIN_USER=siem_admin
CLICKHOUSE_ADMIN_PASSWORD=
CLICKHOUSE_WRITER_PASSWORD=
CLICKHOUSE_GRAFANA_PASSWORD=
# Konto panelu (wyszukiwarka zdarzeń), tylko do odczytu.
CLICKHOUSE_PANEL_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
# Retencja zdarzeń w ClickHouse (dni) – decyzja z roadmapy: 5.
SIEM_EVENTS_TTL_DAYS=5
# Retencja surowego XML (dni, ≤ SIEM_EVENTS_TTL_DAYS). Po jej upływie zostają
# pola znormalizowane, a oryginał jest w archiwum Urd (replay, eksport).
# Agenci wyłączeni z archiwum polityką tracą XML po tym czasie bezpowrotnie.
SIEM_RAW_TTL_DAYS=2
# Pojemność kolejek NATS (MB) i ochrona ingest przed przeciążeniem –
# wartości domyślne pasują do laboratorium, zmieniaj tylko świadomie.
#SIEM_QUEUE_RAW_MAX_MB=8192
#SIEM_QUEUE_EVENTS_MAX_MB=8192
#SIEM_INGEST_MAX_INFLIGHT=64
#SIEM_INGEST_QUEUE_HIGH_WATER=0.9
# Hasła bazy Saga (PostgreSQL) – tylko znaki szesnastkowe, bo trafiają do
# adresu połączenia: openssl rand -hex 24. Każda usługa ma własną rolę:
# saga_admin (tylko administracja), siem_api (panel), siem_archiver (archiwum).
SAGA_ADMIN_PASSWORD=
SAGA_DB_PASSWORD=
SAGA_ARCHIVER_PASSWORD=
# Rola detektora (Gjallarhorn) w bazie Saga. Wygeneruj: openssl rand -hex 24
SAGA_DETECTOR_PASSWORD=
# Token, którym Grafana przekazuje alerty do siem-api (kanały powiadomień
# z panelu). Wygeneruj: openssl rand -hex 32
SIEM_ALERT_RELAY_TOKEN=
# Godzina codziennej kotwicy archiwum Urd na kanałach powiadomień (czas polski).
#SIEM_ANCHOR_HOUR=7
# Adres serwera, który panel wpisuje do paczek instalacyjnych agentów (Bifröst).
SIEM_PUBLIC_SERVER=
# Archiwum NIS2 (Urd): retencja oryginalnych paczek (dni) przy pierwszym
# starcie – potem politykę (włączenie, retencja, źródła) ustawia się w panelu.
SIEM_ARCHIVE_RETENTION_DAYS=30
# Granice polityki z panelu (przejęcie panelu nie skróci retencji poniżej
# minimum) i karencja, po której wchodzi w życie osłabienie polityki.
#SIEM_ARCHIVE_MIN_RETENTION_DAYS=30
#SIEM_ARCHIVE_MAX_RETENTION_DAYS=3650
#SIEM_ARCHIVE_POLICY_GRACE=24h
# Katalog archiwum na VM – najlepiej osobny dysk (np. /srv/heimdall/archive,
# właściciel uid 1000). Domyślnie ./archive w katalogu stosu.
#SIEM_ARCHIVE_PATH=/srv/heimdall/archive
# Agenci zawsze wyłączeni z archiwum (prefiksy, po przecinku) – niezależnie
# od polityki z panelu. Domyślnie generator ruchu (agt-load-); pusta wartość
# archiwizuje wszystko.
#SIEM_ARCHIVE_EXCLUDE_AGENTS=agt-load-
# Ile danych archiwum (GB) weryfikacja czyta w całości w jednym przebiegu.
#SIEM_ARCHIVE_VERIFY_BUDGET_GB=50
# Katalog paczek eksportu dla audytora (właściciel uid 1000), np. na dysku archiwum.
#SIEM_ARCHIVE_EXPORT_PATH=/srv/heimdall/export
# Wysyłka kopii zapasowych poza VM (backup.sh): serwer kopii po SSH z kluczem,
# np. TrueNAS. Kopie są szyfrowane hasłem z ./backup.sh haslo init.
#SIEM_BACKUP_REMOTE=heimdall@192.168.88.180:/mnt/HDD/TANK/heimdall_backup
#SIEM_BACKUP_SSH_KEY=/home/siem/.ssh/heimdall_backup
#SIEM_BACKUP_REMOTE_KEEP_DAYS=90
# Retencja zdarzeń odtworzonych z archiwum (tabela siem.events_replay), dni od odtworzenia.
#SIEM_REPLAY_TTL_DAYS=7
