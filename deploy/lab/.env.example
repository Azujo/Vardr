# Skopiuj do .env i ustaw hasła (np.: openssl rand -base64 24).
# Plik .env nie trafia do repozytorium.
CLICKHOUSE_ADMIN_USER=siem_admin
CLICKHOUSE_ADMIN_PASSWORD=
CLICKHOUSE_WRITER_PASSWORD=
CLICKHOUSE_GRAFANA_PASSWORD=
# Konto panelu (wyszukiwarka zdarzeń), tylko do odczytu.
CLICKHOUSE_PANEL_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
# Retencja zdarzeń w ClickHouse (dni) – decyzja z roadmapy: 5.
SIEM_EVENTS_TTL_DAYS=5
# Retencja surowego XML (dni, ≤ SIEM_EVENTS_TTL_DAYS). Po jej upływie zostają
# pola znormalizowane. Skracaj dopiero, gdy oryginały trafiają do archiwum NIS2.
SIEM_RAW_TTL_DAYS=5
# Pojemność kolejek NATS (MB) i ochrona ingest przed przeciążeniem –
# wartości domyślne pasują do laboratorium, zmieniaj tylko świadomie.
#SIEM_QUEUE_RAW_MAX_MB=8192
#SIEM_QUEUE_EVENTS_MAX_MB=8192
#SIEM_INGEST_MAX_INFLIGHT=64
#SIEM_INGEST_QUEUE_HIGH_WATER=0.9
# Hasła bazy Saga (PostgreSQL) – tylko znaki szesnastkowe, bo trafiają do
# adresu połączenia: openssl rand -hex 24. Każda usługa ma własną rolę:
# saga_admin (tylko administracja), siem_api (panel), siem_archiver (archiwum).
SAGA_ADMIN_PASSWORD=
SAGA_DB_PASSWORD=
SAGA_ARCHIVER_PASSWORD=
# Adres serwera, który panel wpisuje do paczek instalacyjnych agentów (Bifröst).
SIEM_PUBLIC_SERVER=
# Archiwum NIS2 (Urd): retencja oryginalnych paczek (dni) – decyzja z roadmapy: 30.
SIEM_ARCHIVE_RETENTION_DAYS=30
