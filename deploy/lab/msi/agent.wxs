<?xml version="1.0" encoding="utf-8"?>
<!--
  Instalator MSI agenta Vardr (Huginn). Buduje go deploy.sh (cel agent)
  narzędziem wixl na serwerze – z CA tej instalacji (ca.crt).

  Cicha instalacja (GPO/Intune/SCCM, jako administrator albo SYSTEM):
    msiexec /i vardr-agent.msi /qn SERVER=192.168.88.98 TOKEN=hdt_…
  Aktualizacja: ten sam plik w nowszej wersji (bez TOKEN – rejestracja zostaje).
  Odinstalowanie chronionego agenta (ochrona w grupie – domyślnie włączona)
  wymaga jednorazowego tokenu z panelu (Huginn → agent → Token deinstalacji):
    msiexec /x vardr-agent.msi /qn UNINSTALL_TOKEN=XXXXX-XXXXX-XXXXX-XXXXX
  Bez tokenu deinstalacja jest wycofywana, a panel dostaje alert.
  Dane i certyfikaty zostają w %ProgramData%\SiemAgent.
  Przebieg instalacji agenta: %ProgramData%\SiemAgent\msi.log.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="Vardr Agent (Huginn)" Language="1033" Version="$(var.Version)"
           Manufacturer="Vardr SIEM" UpgradeCode="6F1C2A3B-4D5E-4F60-8A71-92B3C4D5E6F7">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine"
             Description="Vardr SIEM agent (Windows Event Log)" Comments="Wersja $(var.Version)"/>
    <Media Id="1" Cabinet="agent.cab" EmbedCab="yes"/>
    <!-- Nowe wydanie agenta = nowy numer wersji: wixl nie obsługuje AllowSameVersionUpgrades, więc
         przebudowany instalator tej samej wersji instaluje się obok poprzedniego (dwa produkty). -->
    <MajorUpgrade DowngradeErrorMessage="Zainstalowana jest nowsza wersja agenta Vardr."/>
    <!-- Wypełniacze stałej długości: panel przy pobraniu instalatora wpisuje
         w ich miejsce adres serwera i token (internal/msipatch) – jeden plik
         MSI do podwójnego kliknięcia. Parametry SERVER= TOKEN= w msiexec mają
         pierwszeństwo; niepodmieniony wypełniacz agent traktuje jak brak. -->
    <Property Id="SERVER" Value="VARDR_MSI_SERVER_==============================================================================================================="/>
    <Property Id="TOKEN" Value="VARDR_MSI_TOKEN_================================================"/>
    <!-- Token nie trafia do dziennika instalatora. -->
    <Property Id="MsiHiddenProperties" Value="TOKEN;UNINSTALL_TOKEN"/>
    <Property Id="ARPNOMODIFY" Value="1"/>
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="SiemAgent">
          <!-- 0.8.0: nowy GUID – program zmienił nazwę (siem_agent.exe → vardr-agent.exe). -->
          <Component Id="AgentExe" Guid="1A2B3C4D-0001-4000-8000-000000000003" Win64="yes">
            <File Id="AgentExe" Name="vardr-agent.exe" Source="vardr-agent.exe" KeyPath="yes"/>
          </Component>
          <Component Id="CaCrt" Guid="1A2B3C4D-0001-4000-8000-000000000002" Win64="yes">
            <File Id="CaCrt" Name="ca.crt" Source="ca.crt" KeyPath="yes"/>
          </Component>
        </Directory>
      </Directory>
    </Directory>
    <Feature Id="Main" Level="1">
      <ComponentRef Id="AgentExe"/>
      <ComponentRef Id="CaCrt"/>
    </Feature>
    <!-- Agent zainstalowany wcześniej bez MSI: zatrzymanie usługi, żeby dało się podmienić plik. -->
    <CustomAction Id="AgentStopOld" FileKey="AgentExe" ExeCommand="stop"
                  Execute="deferred" Impersonate="no" Return="ignore"/>
    <CustomAction Id="AgentInstall" FileKey="AgentExe" ExeCommand="msi-install -server &quot;[SERVER]&quot; -token &quot;[TOKEN]&quot;"
                  Execute="deferred" Impersonate="no" Return="check"/>
    <!-- Aktualizacja (UPGRADINGPRODUCTCODE) nie wymaga tokenu; deinstalacja chronionego agenta – tak. -->
    <CustomAction Id="AgentUninstall" FileKey="AgentExe"
                  ExeCommand="msi-uninstall -token &quot;[UNINSTALL_TOKEN]&quot; -upgrade &quot;[UPGRADINGPRODUCTCODE]&quot;"
                  Execute="deferred" Impersonate="no" Return="check"/>
    <InstallExecuteSequence>
      <RemoveExistingProducts Sequence="1410"/>
      <Custom Action="AgentUninstall" Sequence="3490">REMOVE="ALL"</Custom>
      <Custom Action="AgentStopOld" Sequence="3990">NOT REMOVE</Custom>
      <Custom Action="AgentInstall" Sequence="4010">NOT REMOVE</Custom>
    </InstallExecuteSequence>
  </Product>
</Wix>
