<clickhouse>
    <!-- Mniej szczegółowe logi serwera i ograniczone logi systemowe na małej VM. -->
    <logger>
        <level>warning</level>
    </logger>
    <query_log replace="1">
        <database>system</database>
        <table>query_log</table>
        <ttl>event_date + INTERVAL 3 DAY DELETE</ttl>
    </query_log>
    <trace_log remove="1"/>
    <metric_log remove="1"/>
    <asynchronous_metric_log remove="1"/>
    <text_log remove="1"/>
    <part_log remove="1"/>
    <!-- Nowe w ClickHouse 25.x: przy teście 7000 zdarzeń/s scalanie query_metric_log
         zajmowało 2,2 GB pamięci (etap 8). Metryki zbiera Prometheus. -->
    <query_metric_log remove="1"/>
    <processors_profile_log remove="1"/>

    <!-- Metryki serwera dla Prometheusa (tylko w sieci Dockera). -->
    <prometheus>
        <endpoint>/metrics</endpoint>
        <port>9363</port>
        <metrics>true</metrics>
        <events>true</events>
        <asynchronous_metrics>true</asynchronous_metrics>
    </prometheus>
</clickhouse>
