<clickhouse>
    <!-- Mniej szczegółowe logi serwera i ograniczone logi systemowe na małej VM. -->
    <logger>
        <level>warning</level>
    </logger>
    <query_log replace="1">
        <database>system</database>
        <table>query_log</table>
        <ttl>event_date + INTERVAL 3 DAY DELETE</ttl>
    </query_log>
    <trace_log remove="1"/>
    <metric_log remove="1"/>
    <asynchronous_metric_log remove="1"/>
    <text_log remove="1"/>
    <part_log remove="1"/>
</clickhouse>
